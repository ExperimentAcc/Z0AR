<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/pad">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/pad">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Lightweight gaming accelerator · zero idle footprint"
                android:textColor="@color/text_sub"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Shizuku -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pad"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/pad">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_shizuku"
                android:textColor="@color/text_sub"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvShizukuStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Status: …"
                android:textColor="@color/text"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnShizuku"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/shizuku_connect"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Permissions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pad"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/pad">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_permissions"
                android:textColor="@color/text_sub"
                android:textSize="12sp"
                android:textStyle="bold" />

            <include layout="@layout/row_permission"
                android:id="@+id/rowAcc" />
            <include layout="@layout/row_permission"
                android:id="@+id/rowOverlay" />
            <include layout="@layout/row_permission"
                android:id="@+id/rowNotif" />
            <include layout="@layout/row_permission"
                android:id="@+id/rowDnd" />
        </LinearLayout>

        <!-- Target -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pad"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/pad">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_target"
                android:textColor="@color/text_sub"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTarget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/target_none"
                android:textAllCaps="false" />

            <TextView
                android:id="@+id/tvTarget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_sub"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Mode -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pad"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/pad">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_mode"
                android:textColor="@color/text_sub"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnModeLow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/mode_low"
                android:textAllCaps="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mode_low_desc"
                android:textColor="@color/text_sub"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnModeBalanced"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/mode_balanced"
                android:textAllCaps="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mode_balanced_desc"
                android:textColor="@color/text_sub"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnModeMonster"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/mode_monster"
                android:textAllCaps="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mode_monster_desc"
                android:textColor="@color/text_sub"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Whitelist -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pad"
            android:layout_marginBottom="@dimen/pad"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/pad">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_whitelist"
                android:textColor="@color/text_sub"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/containerWhitelist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvWhitelistEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/whitelist_empty"
                android:textColor="@color/text_sub"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnWhitelistAdd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/whitelist_add"
                android:textAllCaps="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/whitelist_hint"
                android:textColor="@color/text_sub"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
